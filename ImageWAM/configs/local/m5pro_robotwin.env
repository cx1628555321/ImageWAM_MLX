# Source this file from bash or zsh. It only defines paths; it does not install/run anything.
export IMAGEWAM_ROOT=/Users/qklj/work/cx/ImageWAM
export FLUX2_SRC="$IMAGEWAM_ROOT/third_party/flux2"
export FLUX2_VARIANT=4b
export CKPT_PATH="$IMAGEWAM_ROOT/models/robotwin_flux2_4b/model.pt"
export DATASET_STATS_PATH="$IMAGEWAM_ROOT/models/robotwin_flux2_4b/dataset_stats.json"
export FLUX2_MODEL_PATH="$IMAGEWAM_ROOT/models/flux2_klein_base_4b/flux-2-klein-base-4b.safetensors"
export FLUX2_QWEN3_MODEL_SPEC="$IMAGEWAM_ROOT/models/Qwen3-4B"
export FLUX2_AE_DIFFUSERS_PATH="$IMAGEWAM_ROOT/models/flux2_klein_base_4b/vae/diffusion_pytorch_model.safetensors"
# Native AE must be converted from the downloaded Diffusers VAE before inference.
export FLUX2_AE_MODEL_PATH="$IMAGEWAM_ROOT/models/flux2_klein_base_4b/ae.safetensors"
export DATA_ROOT="$IMAGEWAM_ROOT/data/robotwin2.0"
export ROBOTWIN_ROOT="$DATA_ROOT/robotwin2.0"
export ROBOTWIN_CAMERA_LAYOUT=compact_288x256
export PROPRIO_DIM=14
export ACTION_HORIZON=16
export PYTHONPATH="$IMAGEWAM_ROOT/src:$FLUX2_SRC/src${PYTHONPATH:+:$PYTHONPATH}"
